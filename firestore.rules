
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsUserProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUserProfile(data) {
      return data.keys().hasAll([
          'name',
          'city',
          'email',
          'phone',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'city',
          'email',
          'phone',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.city is string
        && data.email is string
        && data.phone is string;
    }

    match /users/{uid} {
      allow read: if ownsUserProfile(uid);

      allow create: if ownsUserProfile(uid)
        && validUserProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if ownsUserProfile(uid)
        && validUserProfile(request.resource.data)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['name', 'city', 'phone', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
